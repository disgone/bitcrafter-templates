<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Configure code analysis -->
    <!-- This is enabled by default in NET5+ -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--#if (treatWarningsAsErrors) -->
    <!-- Treat warning as errors -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!--#endif -->
  </PropertyGroup>

  <!-- Configure generic assembly information -->
  <PropertyGroup>
    <Authors>John Doe</Authors>
    <Company>Acme Inc</Company>
    <Copyright>Copyright © 1999 Acme Inc</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Optional: Configure repository information for Source Link and NuGet packages -->
    <!-- Uncomment and update the following properties if your project is hosted in a public repository -->
    <!--
    <RepositoryUrl>https://github.com/your-org/your-repo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/your-org/your-repo</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    -->
  </PropertyGroup>

  <!--#if (enableCpm) -->
  <!-- Enable Central Package Management (CPM) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--#endif -->

  <!-- Project Conventions -->
  <PropertyGroup>
    <!-- Sets IsTestProject to true if our project followings the convention where unit test project names end in 'Test' or 'Tests' -->
    <IsTestProject Condition=" '$(IsTestProject)' == '' AND ( $(MSBuildProjectName.EndsWith('.Test')) OR $(MSBuildProjectName.EndsWith('.Tests')) ) ">true</IsTestProject>
    <IsTestProject Condition=" '$(IsTestProject)' == '' ">false</IsTestProject>
  </PropertyGroup>

  <!-- Configure Source Link and Deterministic Builds -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl Condition="'$(IsPackable)' == 'true'">true</PublishRepositoryUrl>
    <EmbedUntrackedSources Condition="'$(IsPackable)' == 'true'">true</EmbedUntrackedSources>
    <DebugType Condition="'$(IsPackable)' == 'true'">embedded</DebugType>
  </PropertyGroup>

  <!-- Configure Unit Test Projects -->
  <!-- These properties/references can be removed by default, or overriden with a different version/value if desired -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Generated and added on 01/01/1999 via bitcrafter-buildprops -->
</Project>